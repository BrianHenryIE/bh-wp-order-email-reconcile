{
    "name": "brianhenryie/bh-wc-order-email-reconcile",
    "license": "GPL-2.0-or-later",
    "description": "Class to check an inbox for emails confirming payment for WooCommerce.",
    "type": "wordpress-library",
    "authors": [
        {
            "name": "BrianHenryIE",
            "email": "BrianHenryIE@gmail.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "composer/installers": true,
            "cweagans/composer-patches": true
        }
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "test-plugin/"
        ]
    },
    "repositories": [
        {
            "url": "https://github.com/WordPress/wordpress-develop",
            "type": "git"
        },
        {
            "type":"composer",
            "url":"https://wpackagist.org"
        },
        {
            "type": "path",
            "url": "../bh-wp-mailboxes"
        }
    ],
    "require": {
        "php": ">=8.0",
        "brianhenryie/bh-wp-mailboxes": "dev-master",
        "ddeboer/imap": "^1.11",
        "psr/container": "*",
        "psr/log": "*"
    },
    "require-dev": {
        "vlucas/phpdotenv": "*",
        "10up/wp_mock": "*",
        "antecedent/patchwork": "*",
        "brianhenryie/bh-wp-logger": "*",
        "brianhenryie/color-logger": "*",
        "brianhenryie/composer-phpstorm": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "*",
        "lucatume/wp-browser": "*",
        "phpstan/extension-installer": "*",
        "phpunit/phpcov": "*",
        "squizlabs/php_codesniffer": "*",
        "szepeviktor/phpstan-wordpress": "*",
        "wordpress/wordpress": "*",
        "wp-cli/wp-cli-bundle": "*",
        "wp-cli/dist-archive-command": "*",
        "wp-coding-standards/wpcs": "*",
        "php-stubs/woocommerce-stubs": "*",
        "wpackagist-plugin/woocommerce": "*",
        "wpackagist-theme/storefront": "*"
    },
    "extra": {
        "google/apiclient-services": [
            "Gmail"
        ],
        "phpstorm": {
            "exclude_folders": {
                "folders": [
                    "vendor/php-stubs/woocommerce-stubs",
                    "vendor/wordpress/wordpress/src",
                    "vendor/wordpress/wordpress/build",
                    "wp-content/plugins/bh-wp-order-email-reconcile-test-plugin",
                    "wordpress/wp-content",
                    "test-plugin/vendor"
                ],
                "include_folders": [
                    "vendor/wordpress/wordpress/"
                ],
                "composer-symlinks": false
            }
        }
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup",
        "coverage-tests": [
            "vendor/bin/codecept run unit --coverage unit.cov",
            "vendor/bin/codecept run wpunit --coverage wpunit.cov",
            "vendor/bin/phpcov merge --clover tests/_output/clover.xml --html tests/_output/html tests/_output;",
            "open tests/_output/html/index.html"
        ],
        "lint": [
            "vendor/bin/phpcbf || true",
            "vendor/bin/phpcs || true",
            "vendor/bin/phpstan analyse --memory-limit 1G"
        ],
        "lint-changes": [
            "updated_files=$( git status | grep 'modified:\\s.*.php$' | cut -c14- | awk '{ printf(\"%s \", $0) }' ); vendor/bin/phpcbf $(echo $updated_files); vendor/bin/phpcs $(echo $updated_files); vendor/bin/phpstan analyse $(echo $updated_files) --memory-limit 1G"
        ]
    }
}
