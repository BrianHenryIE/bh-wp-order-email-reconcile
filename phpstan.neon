parameters:
    level: 8
    paths:
        - includes
        - development-plugin
    excludePaths:
        # GiveWP is an unverified, optional integration. Its backing plugin and stubs are not
        # installed here, so its symbols (Give_Payment, give_*()) cannot be resolved. Install GiveWP
        # and add it to scanDirectories to type-check this integration. See ARCHITECTURE.md.
        - includes/integrations/givewp/*
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    scanDirectories:
        - wp-content/plugins
    dynamicConstantNames:
        - BH_WP_ORDER_EMAIL_RECONCILE_TEST_PLUGIN_BASENAME
        - BH_WP_ORDER_EMAIL_RECONCILE_TEST_PLUGIN_VERSION
    ignoreErrors:
        - '#LoggerInterface\|null#'
